# remove any rows with single submovement gestures
gesdat <- gesdat[gesdat$n_submovements > 1, ]
# Basic Menzerath model with corpus in random structure
gesture_menz_model <- lmer(scale(log(subm_dur_ms)) ~ scale(log(n_submovements)) + (1|corpus/speaker/gesture_id), data = gesdat)
gesdat$test <- log(gesdat$n_peaks_shoulder*gesdat$n_peaks_elbow*gesdat$n_peaks_wrist*gesdat$n_peaks_index)
# remove any rows with single submovement gestures
gesdat <- gesdat[gesdat$n_submovements > 1, ]
# Basic Menzerath model with corpus in random structure
gesture_menz_model <- lmer(scale(log(subm_dur_ms)) ~ scale(log(n_submovements))*scale(gesdat$test) + (1|corpus/speaker/gesture_id), data = gesdat)
# remove any rows with single submovement gestures
gesdat <- gesdat[gesdat$n_submovements > 1, ]
# Basic Menzerath model with corpus in random structure
gesture_menz_model <- lmer(scale(log(subm_dur_ms)) ~ scale(log(n_submovements))*scale(gesdat$test) + (1|corpus/speaker/gesture_id), data = gesdat)
gesdat$test <- ifelse(is.numeric(gesdat$test), gesdat$test, NA)
# remove any rows with single submovement gestures
gesdat <- gesdat[gesdat$n_submovements > 1, ]
# Basic Menzerath model with corpus in random structure
gesture_menz_model <- lmer(scale(log(subm_dur_ms)) ~ scale(log(n_submovements))*scale(gesdat$test) + (1|corpus/speaker/gesture_id), data = gesdat)
summary(gesture_menz_model)
