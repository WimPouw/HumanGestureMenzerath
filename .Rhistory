library(cowplot)
library(ggplot2)
# Use this conditional approach:
if (rstudioapi::isAvailable()) {
# Running in RStudio
current_dir <- dirname(rstudioapi::getSourceEditorContext()$path)
} else {
# Running outside RStudio (like command line quarto)
current_dir <- here::here()
}
gesdat <- read.csv(paste0(current_dir, "/Data_Output/gestures_long.csv"))
# ensure factor variables are set
gesdat$gesture_id <- as.factor(gesdat$gesture_id)
gesdat$corpus <- as.factor(gesdat$corpus)
gesdat$speaker <- as.factor(gesdat$speaker)
gesdat$subtype <- as.factor(gesdat$subtype)
gesdat$condition <- as.factor(gesdat$condition)
# Set some plotting defaults
# set some plotting themes
library(RColorBrewer)
# Enhanced plotting theme
my_theme <- function() {
theme_cowplot() +
theme(
# Text elements
text = element_text(size = 10, family = "sans"),
axis.text = element_text(size = 9, color = "grey20"),
axis.title = element_text(size = 11, face = "bold"),
plot.title = element_text(size = 12, face = "bold", hjust = 0),
# Grid and background
panel.grid.major = element_line(color = "grey90", linewidth = 0.3),
panel.grid.minor = element_blank(),
panel.background = element_rect(fill = "white", color = NA),
plot.background = element_rect(fill = "white", color = NA),
# Legend
legend.text = element_text(size = 9),
legend.title = element_text(size = 10, face = "bold"),
legend.position = "right",
legend.background = element_rect(fill = "white", color = "grey80"),
legend.key = element_rect(fill = "white", color = NA),
# Margins
plot.margin = margin(10, 10, 10, 10)
)
}
# Color palette function
get_palette <- function(n, palette = "Set2") {
brewer.pal(min(n, brewer.pal.info[palette, "maxcolors"]), palette)
}
# For continuous scales
scale_color_publication <- function(...) {
scale_color_brewer(palette = "Set2", ...)
}
scale_fill_publication <- function(...) {
scale_fill_brewer(palette = "Set2", ...)
}
