  doi = {10.1007/978-94-011-1769-2_4},
  urldate = {2025-03-15},
  abstract = {Synergetics is a special type of systems theoretical modelling whose specific characteristic is the treatment of the spontaneous rise and development of structures. The exponents of this interdisciplinary approach in the field of linguistics have shown that synergetics is also compatible with the functional analytic models and explanatory approaches of quantitative linguistics. It provides concepts which are applicable to the phenomena of self-regulation and self-organisation as they are investigated in quantitative linguistics. Like other self-organising systems, language is characterised by the presence of cooperative and competitive processes which, together with the external forces of biology, psychology, physics, the social system and others, form the dynamics of the system.},
  isbn = {978-94-011-1769-2},
