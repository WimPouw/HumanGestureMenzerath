@article{hupetChangesRepeatedReferences1992,
  title = {Changes in Repeated References: {{Collaboration}} or Repetition Effects?},
  shorttitle = {Changes in Repeated References},
  author = {Hupet, Michel and Chantraine, Yves},
  year = 1992,
  journal = {Journal of Psycholinguistic Research},
  volume = {21},
  number = {6},
  pages = {485--496},
  publisher = {Springer},
  address = {Germany},
  issn = {1573-6555},
  abstract = {Tested H. H. Clark and D. Wilkes-Gibbs's (see record 1987-07185-001) collaborative model of reference, according to which the repetition of a referential communication task produces changes in the making of references and these changes are interpreted as revealing the outgrowth of a collaborative process aiming at mutual understanding at the lowest cost. A repeated referential paradigm without any physically present interlocutor was used to determine whether these changes are attributable to the mere repetition of the referential task. Ss were 48 native-French-speaking college students. In a different-addressee (DA) condition, Ss were told before each new trial that they would be presented later to another person; in a same-addressee (SA) condition, Ss were told before each new trial that what they would say would be presented to the same person. With the passing trials, Ss in the DA condition produced more and more words but did not use any definite references or labels. In the SA condition, the number of words remained constant. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Cooperation,Oral Communication}
}

